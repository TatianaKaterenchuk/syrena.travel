{
  "expo": {
    "name": "Syrena Travel",
    "slug": "syrena-travel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "syrena-travel",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F0E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alegro.syrena-travel",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyBnYqu6JhN1NQVNkDXN_zhpmNoWy4lFAzo"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Syrena Travel uses your location to show nearby places on the map and help you discover destinations around you.",
        "NSPhotoLibraryUsageDescription": "Syrena Travel needs access to your photos to set your profile picture and add photos to places.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F0E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.syrena.travel",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBnYqu6JhN1NQVNkDXN_zhpmNoWy4lFAzo"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Syrena Travel uses your location to show nearby places on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Syrena Travel needs access to your photos to set your profile picture and add photos to places."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C4A265"
        }
      ]
    ],
    "extra": {
      "router": {},
      "googlePlacesApiKey": "AIzaSyBnYqu6JhN1NQVNkDXN_zhpmNoWy4lFAzo",
      "googleWebClientId": "511200626594-afcgvuv813j9onooe66l6oqc63j26avj.apps.googleusercontent.com",
      "eas": {
        "projectId": "da66342d-567d-4d60-b19c-83206174c6fe"
      }
    },
    "owner": "alegro"
  }
}
